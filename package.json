{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 180000 test/integration",
    "migration:create": "bun src/database/migrate.ts create",
    "migration:up": "bun src/database/migrate.ts up",
    "migration:down": "bun src/database/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1148.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/nestjs": "6.1.2",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testcontainers/localstack": "11.14.0",
    "@testcontainers/postgresql": "11.14.0",
    "@types/bun": "1.4.2",
    "@types/express": "5.0.3",
    "testcontainers": "11.14.0",
    "typescript": "5.9.3"
  }
}
