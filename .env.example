# Copie para .env e ajuste. O arquivo .env NÃO é versionado.
# Sem nenhum valor preenchido, tudo funciona localmente:
# os e-mails de alerta chegam no Mailpit (http://localhost:8025).

# --- Webhook Grafana -> aplicação (relatório de incidente) ---
# Valor só para ambiente local; troque em qualquer ambiente compartilhado.
ALERT_WEBHOOK_TOKEN=local-dev-only

# --- E-mail de alerta ---
ALERT_EMAIL_TO=ops@wagering.local
ALERT_EMAIL_FROM=alerts@wagering.local
# SMTP real (opcional). Vazio = Mailpit (smtp://mailpit:1025)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
